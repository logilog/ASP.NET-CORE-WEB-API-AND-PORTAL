@model HaberViewModel
@{
    Layout = "_LayoutPageBase";
    ViewData["Title"] = Model != null && Model.Haber != null ? Model.Haber.BASLIK : "Haber";
}
<div class="card">
    <div class="card-body">
        <a asp-controller="Haber" asp-action="Liste" class="btn btn-sm btn-light mb-3"><i class="fas fa-arrow-left"></i> Haberler</a>
        @if (Model != null && Model.Haber != null)
        {
            <div class="text-center mb-3" style="font-size:3rem;">@Model.Haber.GORSEL</div>
            <h3>@Model.Haber.BASLIK</h3>
            <p class="text-muted"><i class="far fa-clock"></i> @(Model.Haber.TARIH?.ToString("dd.MM.yyyy HH:mm")) &bull; @Model.Haber.YAZAR</p>
            <p class="lead">@Model.Haber.OZET</p>
            <hr />
            <p style="white-space:pre-line;">@Model.Haber.ICERIK</p>
        }
        else
        {
            <div class="alert alert-warning">Haber bulunamadı. @Model?.Message</div>
        }
    </div>
</div>
