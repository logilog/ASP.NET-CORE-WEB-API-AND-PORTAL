@model HaberViewModel
@{
    Layout = "_LayoutPageBase";
    ViewData["Title"] = "Haberler";
}
<div class="card">
    <div class="card-body">
        <h4 class="text-info"><i class="fas fa-newspaper"></i> Haberler</h4>
        @if (Model != null && !Model.Success)
        {
            <div class="alert alert-warning">@Model.Message</div>
        }
        <div class="row mt-2">
            @if (Model != null && Model.HaberListesi != null)
            {
                foreach (var h in Model.HaberListesi)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex">
                                    <div class="mr-3" style="font-size:2.2rem;">@h.GORSEL</div>
                                    <div>
                                        <h5 class="card-title mb-1">@h.BASLIK</h5>
                                        <small class="text-muted"><i class="far fa-clock"></i> @(h.TARIH?.ToString("dd.MM.yyyy HH:mm")) &bull; @h.YAZAR</small>
                                    </div>
                                </div>
                                <p class="mt-2 mb-2 text-muted">@h.OZET</p>
                                <a asp-controller="Haber" asp-action="Detay" asp-route-id="@h.ID" class="btn btn-sm btn-outline-info">Devamını oku <i class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
