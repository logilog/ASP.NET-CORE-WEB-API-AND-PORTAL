@model TahminViewModel
@{
    Layout = "_LayoutPageBase";
    ViewData["Title"] = "Tahminlerim";
    var toplam = (Model != null && Model.TahminListesi != null)
        ? Model.TahminListesi.Where(x => x.PUAN != null).Sum(x => x.PUAN.Value)
        : 0;
}
<div class="card">
    <div class="card-body">
        <div class="row align-items-center mb-3">
            <div class="col">
                <h4 class="text-info mb-0"><i class="fas fa-clipboard-list"></i> Tahminlerim</h4>
            </div>
            <div class="col-auto">
                <span class="badge badge-pill badge-warning p-2" style="font-size:1rem;"><i class="fas fa-star"></i> Toplam Puan: @toplam</span>
                <a asp-controller="Mac" asp-action="Liste" class="btn btn-info btn-sm ml-2"><i class="fas fa-plus"></i> Yeni Tahmin</a>
            </div>
        </div>

        @if (Model != null && !Model.Success)
        {
            <div class="alert alert-warning">@Model.Message</div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Maç</th>
                        <th class="text-center">Tahminim</th>
                        <th class="text-center">Sonuç</th>
                        <th class="text-center">Puan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.TahminListesi != null)
                    {
                        foreach (var t in Model.TahminListesi)
                        {
                            <tr>
                                <td><small>@(t.MACTARIHI?.ToString("dd.MM.yyyy HH:mm"))</small></td>
                                <td>@t.EVSAHIBIAD <span class="text-muted">-</span> @t.DEPLASMANAD</td>
                                <td class="text-center"><span class="badge badge-light">@t.EVSAHIBISKOR - @t.DEPLASMANSKOR</span></td>
                                <td class="text-center">
                                    @if (t.MACDURUM == "BITTI")
                                    {
                                        <span class="badge badge-dark">@t.GERCEKEVSKOR - @t.GERCEKDEPSKOR</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (t.PUAN == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (t.PUAN == 5)
                                    {
                                        <span class="badge badge-success">+5 Tam Skor!</span>
                                    }
                                    else if (t.PUAN == 3)
                                    {
                                        <span class="badge badge-info">+3</span>
                                    }
                                    else if (t.PUAN == 2)
                                    {
                                        <span class="badge badge-secondary">+2</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">0</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
